# Copy this file to ".env" and fill in your own values.
# ".env" is git-ignored, so your real values are never committed.

# Google Gemini (AI chatbot) - get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Supabase Auth (signup/login) - Project Settings > API in your Supabase dashboard
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
